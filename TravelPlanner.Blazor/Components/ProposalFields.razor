<div class="mb-3">
    <label for="proposal-title" class="form-label">Название</label>
    <input id="proposal-title" class="form-control" maxlength="200" required @bind="Model.Title" />
</div>
<div class="mb-3">
    <label for="proposal-description" class="form-label">Описание</label>
    <textarea id="proposal-description" class="form-control" rows="4" maxlength="4000" @bind="Model.Description"></textarea>
</div>
<div class="mb-3">
    <label for="proposal-cost" class="form-label">Плановая стоимость</label>
    <input id="proposal-cost" class="form-control" type="number" min="0" max="9999999999.99" step="0.01" required @bind="Model.PlannedCost" />
</div>

@code {
    [Parameter, EditorRequired] public ProposalRequest Model { get; set; } = new();
}

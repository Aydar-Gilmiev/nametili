@page "/register"
@inject ApiRequest ApiRequest
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>
<h1>Регистрация</h1>
<p class="auth-note">Создайте аккаунт, чтобы планировать поездки вместе с друзьями.</p>
<form class="edit-form" @onsubmit="RegisterUser" @onsubmit:preventDefault>
    <fieldset disabled="@isSaving">
        <div class="mb-3">
            <label for="register-name" class="form-label">Имя</label>
            <input id="register-name" class="form-control" autocomplete="name" required @bind="regRequest.Name" />
        </div>
        <div class="mb-3">
            <label for="register-email" class="form-label">Электронная почта</label>
            <input id="register-email" class="form-control" type="email" autocomplete="username" maxlength="254" required @bind="regRequest.Email" />
        </div>
        <div class="mb-3">
            <label for="register-password" class="form-label">Пароль — не меньше 8 символов</label>
            <input id="register-password" class="form-control" type="password" autocomplete="new-password" minlength="8" required @bind="regRequest.Password" />
        </div>
        <button class="btn btn-primary" type="submit">@(isSaving ? "Сохраняем..." : "Зарегистрироваться")</button>
    </fieldset>
</form>
@if (errorMessage != "") { <p class="text-danger mt-3" role="alert">@errorMessage</p> }
<p class="mt-3">Уже есть аккаунт? <a href="/login">Войти</a></p>

@code {
    private RegRequest regRequest = new();
    private string errorMessage = "";
    private bool isSaving;
    private async Task RegisterUser()
    {
        if (isSaving) return;
        isSaving = true;
        errorMessage = "";
        try
        {
            var result = await ApiRequest.Register(regRequest);
            if (!result.status || result.data == null) { errorMessage = result.message; return; }
            await CurrentUser.SignIn(result.data);
            Navigation.NavigateTo("/trips");
        }
        finally { isSaving = false; }
    }
}
